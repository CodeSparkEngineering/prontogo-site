# URL pública do site — usada em metadata (Open Graph), sitemap.xml e robots.txt
NEXT_PUBLIC_SITE_URL=https://prontogo.pt

# Formulário de contacto — envio via Resend (https://resend.com)
# Sem RESEND_API_KEY o formulário mostra erro com fallback para email direto.
RESEND_API_KEY=
# Destino dos pedidos de orçamento (default: geral@prontogo.pt)
CONTACT_TO_EMAIL=geral@prontogo.pt
# Remetente — tem de ser um domínio verificado no Resend
# (default onboarding@resend.dev serve apenas para testes)
CONTACT_FROM_EMAIL="ProntoGo <pedidos@prontogo.pt>"
